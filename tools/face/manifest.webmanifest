  "theme_color": "#0b0d14",
  "icons": [
    { "src": "/face/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/face/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
