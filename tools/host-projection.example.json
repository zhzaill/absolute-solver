{
  "listenHost": "0.0.0.0",
  "listenPort": 18111,
  "cooBaseUrl": "http://127.0.0.1:7797",
  "corticoBaseUrl": "http://127.0.0.1:17788",
  "hubBaseUrl": "http://127.0.0.1:18100",
  "tls": {
    "enabled": true,
    "port": 18112,
    "commonName": "absolute-solver.local"
  },
  "network": {
    "lan": true,
    "tailscale": { "enabled": true }
  },
  "device": {
    "enabled": false,
    "host": "192.168.1.166",
    "port": 22,
    "user": "your-ssh-user",
    "identityFile": "C:/Users/you/.ssh/id_ed25519",
    "knownHostsFile": "C:/Users/you/.ssh/known_hosts",
    "strictHostKeyChecking": "yes",
    "remoteHost": "127.0.0.1",
    "tunnels": {
      "coo": { "remotePort": 7797, "localPort": 27797 },
      "cortico": { "remotePort": 17788, "localPort": 27788 },
      "asr": { "remotePort": 9881, "localPort": 29881 },
      "tts": { "remotePort": 18080, "localPort": 28080 },
      "llm": { "remotePort": 18081, "localPort": 28081 }
    }
  },
  "host": {
    "id": "solver-host",
    "name": "Solver Host",
    "address": null
  },
  "services": [
    {
      "id": "cortico-world",
      "name": "Cortico World",
      "type": "world",
      "baseUrl": "http://127.0.0.1:7797",
      "healthPath": "/api/state",
      "interfaceUrl": "http://127.0.0.1:7797/pet",
      "version": "unknown",
      "capabilities": ["pet-renderer", "world-state"]
    },
    {
      "id": "asr",
      "name": "ASR Provider",
      "type": "asr",
      "baseUrl": "http://127.0.0.1:9881",
      "healthPath": "/v1/models",
      "version": "unknown",
      "capabilities": ["transcription"]
    },
    {
      "id": "llm",
      "name": "LLM Provider",
      "type": "llm",
      "baseUrl": "http://127.0.0.1:18081",
      "healthPath": "/health",
      "version": "unknown",
      "capabilities": ["generation"]
    },
    {
      "id": "tts",
      "name": "TTS Provider",
      "type": "tts",
      "baseUrl": "http://127.0.0.1:18080",
      "healthPath": "/healthz",
      "version": "unknown",
      "capabilities": ["speech-synthesis"]
    }
  ]
}
