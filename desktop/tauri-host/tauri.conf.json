{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Absolute Solver Host",
  "version": "0.1.0",
  "identifier": "net.absolutesolver.host",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Absolute Solver Host",
        "width": 520,
        "height": 420,
        "visible": false,
        "center": true,
        "resizable": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
